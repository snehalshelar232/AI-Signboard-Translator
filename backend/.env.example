# ========================================================
# AI-to-AI: Smart Signboard Translation and Voice Assistant
# Environment Configuration Template
# ========================================================

# Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Google Gemini API Key (RECOMMENDED for 99%+ accuracy on all Indic scripts including Gujarati and Marathi)
# Obtain free at: https://aistudio.google.com
# Zero credit card required; 15 requests per minute free
# If left blank, the backend automatically runs local EasyOCR for offline demo
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Path to local Tesseract OCR binary (for offline Gujarati/Indic OCR)
# Default auto-detects 'C:\Program Files\Tesseract-OCR\tesseract.exe'
TESSERACT_PATH=

# OCR Confidence threshold (0.0 to 1.0)
# Below this score, the user is prompted to verify/edit before translation
CONFIDENCE_THRESHOLD=0.70

# Discrepancy threshold for secondary verification (0.0 to 1.0)
DISCREPANCY_THRESHOLD=0.35
